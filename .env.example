# SoundCloud Official API (OAuth 2.1)
# https://developers.soundcloud.com/docs/api/register-app
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Optional guest client_id for api-v2 fallback when official API returns 403 from VPS
# SOUNDCLOUD_LEGACY_CLIENT_ID=

# Cloudflare Worker for RF audio — see workers/soundcloud-relay.js
# SOUNDCLOUD_RELAY_URL=https://sc-relay.YOUR_ACCOUNT.workers.dev
# SOUNDCLOUD_RELAY_SECRET=long-random-string
# Do NOT add a Workers Route on render.kanekiq.ru (it 302s covers to /artworks-… 404).

# Optional paid HTTP/SOCKS proxy for origin API only
# SOUNDCLOUD_PROXY_URL=socks5://user:pass@host:1080

# Force same-origin media even without a hop (usually 403 from datacenter IPs)
# RENDER_PROXY_MEDIA=1
# RENDER_STREAM_PROXY=1

# Production
# NODE_ENV=production
# SERVE_CLIENT=1
# DISCORD_RPC_SERVER=0
# DB_POOL_LIMIT=8

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

