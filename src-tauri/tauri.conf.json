{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Render",
  "version": "1.0.1",
  "identifier": "com.render.player",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://31.77.11.88:5000",
    "beforeBuildCommand": "node desktop/configure-remote.js",
    "frontendDist": "../client/build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Render",
        "url": "http://31.77.11.88:5000",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,TranslateUI,BackForwardCache,InterestFeedContentSuggestions,MediaRouter,OptimizationHints,CalculateNativeWinOcclusion --disable-background-networking --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-breakpad --disable-client-side-phishing-detection --disable-component-update --disable-default-apps --disable-domain-reliability --disable-hang-monitor --disable-ipc-flooding-protection --disable-popup-blocking --disable-prompt-on-repost --disable-renderer-backgrounding --disable-sync --disable-extensions --metrics-recording-only --no-first-run --no-default-browser-check --no-pings --disk-cache-size=33554432 --media-cache-size=16777216 --renderer-process-limit=1 --js-flags=--max-old-space-size=192 --disable-gpu-shader-disk-cache"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {},
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Render",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "untrusted comment: minisign public key: 8C5BA62DCC67DF99\nRWSZ32fMLaZbjMNtXiInyELZnGQS+UeA3z8GgiYLHkzsiFwQX5y5f7i",
      "endpoints": [
        "https://github.com/Kenkanekiqwe/render-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
